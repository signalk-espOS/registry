    {
      "id": "cockpit",
      "app": "cockpit",
      "name": "P4 Cockpit",
      "summary": "Touch instrument panel for Signal K, on a Waveshare ESP32-P4 display",
      "description": "A configurable instrument panel: gauges, arcs, anchor watch and digital switching, laid out in the Signal K HMI designer and rendered on the panel. Also does voice control and NMEA 2000 over CAN.",
      "repo": "dirkwa/espos-p4-cockpit",
      "license": "Apache-2.0",
      "targets": [
        "esp32p4"
      ],
      "boards": [
        {
          "id": "waveshare-p4-touch-7b",
          "target": "esp32p4",
          "name": "Waveshare ESP32-P4-WIFI6-Touch-LCD-7B (1024x600)",
          "flashMinBytes": 16777216,
          "notes": "1024x600 landscape, EK79007 controller. The 7B and the X are different boards: the wrong firmware leaves the screen black, because each drives a backlight pin the other does not connect.",
          "buyUrl": "https://www.waveshare.com/esp32-p4-wifi6-touch-lcd-7b.htm"
        },
        {
          "id": "waveshare-p4-touch-x-7",
          "target": "esp32p4",
          "name": "Waveshare ESP32-P4-WIFI6-Touch-LCD-X, 7 inch (720x1280, rotated)",
          "flashMinBytes": 16777216,
          "notes": "720x1280 portrait ILI9881C on a 7-inch panel, shown rotated to landscape by the P4 PPA. Each size in the X series uses a different display controller, so a build is specific to one: the 8-inch and 10.1-inch X panels are JD9365 and are not supported. Not interchangeable with the 7B either — see that board's note."
        }
      ],
      "channels": [
        "stable",
        "beta"
      ],
