    {
      "id": "ble-gateway",
      "app": "ble_gateway",
      "name": "BLE Gateway",
      "summary": "Bridges Bluetooth sensors into Signal K",
      "description": "Scans for Bluetooth Low Energy sensors — temperature, humidity, battery monitors — and forwards their readings to a Signal K server.\n\nRuns on the ESP32-P4 (BLE via its ESP32-C6 co-processor, which is what two gateways here use in daily service) and on the ESP32, C3, S3 and C6.\n\nNot the ESP32-C5: it builds and scans, then reboots after about 30 seconds. BLE plus WiFi plus the Signal K client needs ~152 KB of its ~176 KB of internal RAM, the HTTP posts start failing and the health watchdog restarts the board. Its 8 MB of PSRAM does not help — what remains is task stacks and DMA buffers, which cannot live in external RAM. A C5 is a good WiFi/Signal K board, but it is not a BLE bridge.",
      "repo": "dirkwa/espos-ble-gateway",
      "license": "Apache-2.0",
      "targets": [
        "esp32p4",
        "esp32",
        "esp32s3",
        "esp32c3",
        "esp32c6"
      ],
      "boards": [
        {
          "id": "esp32c6-devkit",
          "target": "esp32c6",
          "name": "ESP32-C6 development board",
          "notes": "The ESP32-C6-MINI-1U has no PCB antenna: without an external one the radio sees nothing, which looks exactly like a software fault.",
          "assetSegment": "esp32c6"
        },
        {
          "id": "esp32c3-devkit",
          "target": "esp32c3",
          "name": "ESP32-C3 development board",
          "assetSegment": "esp32c3"
        },
        {
          "id": "esp32s3-devkit",
          "target": "esp32s3",
          "name": "ESP32-S3 development board",
          "assetSegment": "esp32s3"
        },
        {
          "id": "esp32-devkit",
          "target": "esp32",
          "name": "ESP32 development board",
          "assetSegment": "esp32"
        },
        {
          "id": "waveshare-p4-poe",
          "target": "esp32p4",
          "name": "Waveshare ESP32-P4-WIFI6-POE-ETH",
          "notes": "Never connect USB and Ethernet at the same time: powering the board from USB and PoE together damages it.",
          "assetSegment": "esp32p4"
        }
      ],
      "assets": {
